# Add the TMDB Read Access Token when implementing the movie catalog.
TMDB_READ_ACCESS_TOKEN=

# Local PostgreSQL connection. Keep this empty until the database block.
DATABASE_URL=

# Better Auth settings. Use a random secret with at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials. Both values must be provided together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
